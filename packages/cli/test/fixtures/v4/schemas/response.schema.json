{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shipflow:v4:response",
  "$ref": "#/$defs/response",
  "$defs": {
    "action": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "read_only",
            "write_own_state",
            "user_decision"
          ]
        }
      },
      "required": [
        "command",
        "arguments",
        "purpose",
        "effect"
      ],
      "additionalProperties": false
    },
    "sourceStatus": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "current",
            "stale",
            "unverified",
            "excluded"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "sourceId",
        "sourceVersion",
        "status",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "path"
      ],
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "project"
            },
            "paths": {
              "const": []
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "paths"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "paths": {
              "const": []
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "additionalProperties": false
        }
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "const": "local_declared"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      },
      "required": [
        "label",
        "role",
        "authority",
        "scope"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "source"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "sourceType": {
          "enum": [
            "local",
            "external"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "contentDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "enum": [
            "current",
            "unverified",
            "excluded"
          ]
        }
      },
      "required": [
        "kind",
        "title",
        "scope",
        "lifecycle",
        "sourceType",
        "locator",
        "purpose",
        "contentDigest",
        "observation"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "rule"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "lifecycle": {
          "enum": [
            "proposed",
            "active",
            "replaced",
            "retired"
          ]
        },
        "replacementRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "ruleClass": {
          "enum": [
            "obligation",
            "prohibition",
            "preference"
          ]
        },
        "alternative": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "exceptionPolicy": {
          "enum": [
            "not_allowed",
            "requires_authority",
            "unspecified"
          ]
        },
        "support": {
          "enum": [
            "human_declaration",
            "source_supported"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "ref",
              "version"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "evidenceLevel": {
          "const": "declared"
        }
      },
      "required": [
        "kind",
        "title",
        "scope",
        "lifecycle",
        "replacementRef",
        "statement",
        "reason",
        "ruleClass",
        "alternative",
        "exceptionPolicy",
        "support",
        "sourceRefs",
        "evidenceLevel"
      ],
      "additionalProperties": false
    },
    "pending": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "pending"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "revisitWhen": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "ref",
              "version"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "decisionReview": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "reviewer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "ref",
                "version",
                "reviewer"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "title",
        "scope",
        "status",
        "question",
        "reason",
        "revisitWhen",
        "sourceRefs",
        "resolution",
        "decisionReview"
      ],
      "additionalProperties": false
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "$ref": "#/$defs/rule"
        },
        {
          "$ref": "#/$defs/pending"
        }
      ]
    },
    "version": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "previousVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      },
      "required": [
        "id",
        "version",
        "previousVersion",
        "payload"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      },
      "required": [
        "key",
        "targetId",
        "expectedVersion",
        "payload"
      ],
      "additionalProperties": false
    },
    "proposedChange": {
      "type": "object",
      "properties": {
        "change": {
          "enum": [
            "create",
            "revise",
            "retire",
            "replace",
            "resolve"
          ]
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "change",
        "version"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "shipflow.basis.input"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedBasisDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "projectId",
        "expectedBasisDigest",
        "actor",
        "reason",
        "changes"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "operationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "draftDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "previousEventDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "eventDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "revision",
        "operationId",
        "acceptedAt",
        "actor",
        "reason",
        "draftDigest",
        "previousEventDigest",
        "changes",
        "eventDigest"
      ],
      "additionalProperties": false
    },
    "reading": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "additionalProperties": false
    },
    "basis": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "shipflow.basis"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1
        },
        "validatorVersion": {
          "const": 1
        },
        "queryVersion": {
          "const": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "projectId",
        "revision",
        "producerVersion",
        "validatorVersion",
        "queryVersion",
        "events",
        "digest"
      ],
      "additionalProperties": false
    },
    "draft": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "shipflow.basis.draft"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expectedBasisDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "contextProjectDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "preparedChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "sourceReads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reading"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "projectId",
        "operationId",
        "createdAt",
        "expectedBasisDigest",
        "contextProjectDigest",
        "input",
        "preparedChanges",
        "sourceReads",
        "digest"
      ],
      "additionalProperties": false
    },
    "journal": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "shipflow.basis.transaction"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "phase": {
          "enum": [
            "prepared",
            "published"
          ]
        },
        "before": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "acceptedDraftDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "contextProjectDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceReads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reading"
          }
        },
        "candidatePath": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "projectId",
        "operationId",
        "phase",
        "before",
        "after",
        "acceptedDraftDigest",
        "acceptedAt",
        "actor",
        "contextProjectDigest",
        "sourceReads",
        "candidatePath",
        "digest"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "bootstrap"
        },
        "operation": {
          "enum": [
            "guide",
            "prepare",
            "show",
            "accept",
            "discard",
            "recover"
          ]
        },
        "exitCode": {
          "enum": [
            0,
            64,
            65,
            66,
            70,
            74,
            75,
            130
          ]
        },
        "outcome": {
          "enum": [
            "published",
            "shown",
            "discarded",
            "already_applied",
            "recovered",
            "no_changes",
            "aborted_before_publication",
            "draft_prepared",
            "choice_required",
            "blocked",
            "failed",
            "cancelled"
          ]
        },
        "storageIntegrity": {
          "type": "object",
          "properties": {
            "basis": {
              "enum": [
                "absent",
                "valid",
                "invalid",
                "incompatible",
                "unverified"
              ]
            },
            "draft": {
              "enum": [
                "absent",
                "valid",
                "invalid",
                "incompatible",
                "unverified"
              ]
            },
            "transaction": {
              "enum": [
                "absent",
                "valid",
                "invalid",
                "incompatible",
                "unverified"
              ]
            }
          },
          "required": [
            "basis",
            "draft",
            "transaction"
          ],
          "additionalProperties": false
        },
        "basisDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "draftDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "published": {
          "type": "boolean"
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "normativeCoverage": {
          "enum": [
            "not_established",
            "declared_partial"
          ]
        },
        "selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "reviewTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "proposedChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposedChange"
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "sourceStatus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceStatus"
          }
        },
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "selection": {
