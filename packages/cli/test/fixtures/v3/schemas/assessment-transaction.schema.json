{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "projectId",
    "operationId",
    "before",
    "after",
    "candidatePath",
    "state",
    "baseContextDigest",
    "snapshotId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "shipflow.assessment-transaction"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "before": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "after": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidatePath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
    },
    "state": {
      "enum": [
        "prepared",
        "published"
      ]
    },
    "baseContextDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
